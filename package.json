{
  "name": "ocpipe",
  "version": "0.6.17",
  "description": "SDK for LLM pipelines with Prime Agent, OpenCode, OMP, Codex, Claude Code, Pi, and Zod",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s4wave/ocpipe.git"
  },
  "homepage": "https://github.com/s4wave/ocpipe",
  "bugs": {
    "url": "https://github.com/s4wave/ocpipe/issues"
  },
  "license": "MIT",
  "author": "s4wave",
  "keywords": [
    "dspy",
    "prime-agent",
    "omp",
    "opencode",
    "codex",
    "claude-code",
    "typescript",
    "ai",
    "workflow",
    "pipeline",
    "bun"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "peerDependencies": {
    "zod": "4.5.4",
    "@anthropic-ai/claude-agent-sdk": "0.3.261",
    "@openai/codex-sdk": "0.153.4"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@openai/codex-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.197",
    "@openai/codex-sdk": "0.153.4",
    "@typescript/native-preview": "^7.0.0-dev.20260630.1",
    "bun-types": "^1.3.14",
    "oxfmt": "0.66.0",
    "oxlint": "^1.76.0",
    "rimraf": "^6.1.3",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "bun run clean && tsgo --project tsconfig.build.json",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "bun scripts/test-package.ts",
    "prepack": "bun run build",
    "release": "npm run release:version && npm run release:commit",
    "release:minor": "npm run release:version:minor && npm run release:commit",
    "release:version": "npm version patch -m \"release: v%s\" --no-git-tag-version",
    "release:version:minor": "npm version minor -m \"release: v%s\" --no-git-tag-version",
    "release:commit": "git reset && git add package.json && git commit -s -m \"release: v$(node -p \"require('./package.json').version\")\" && git tag v$(node -p \"require('./package.json').version\")",
    "release:publish": "git push && git push --tags"
  },
  "files": [
    "dist",
    "example/",
    "llms.txt",
    "README.md",
    "LICENSE",
    "GETTING_STARTED.md",
    "DESIGN.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  }
}
